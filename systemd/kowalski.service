[Unit]
Description=Kowalski - render generative art on boot

[Service]
Type=oneshot
User=@USER@
Environment="PATH=@HOME@/.local/share/fnm/aliases/default/bin:/usr/local/bin:/usr/bin:/bin"
Environment="PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium"
WorkingDirectory=@REPO_DIR@
ExecStart=@REPO_DIR@/.venv/bin/python @REPO_DIR@/display/show.py generative
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
